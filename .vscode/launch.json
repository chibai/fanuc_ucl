{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: protocol tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/cpp/snpx_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "CMake: build Debug"
        },
        {
            "name": "Debug: client integration tests (loopback)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/cpp/snpx_client_integration",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "CMake: build Debug"
        },
        {
            "name": "Debug: SNP-X example (clears controller ASG)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/cpp/snpx_example",
            "args": ["${input:controllerHost}"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": false
                }
            ],
            "preLaunchTask": "CMake: build Debug"
        }
    ],
    "inputs": [
        {
            "id": "controllerHost",
            "type": "promptString",
            "description": "Controller IP/host. WARNING: connecting sends CLRASG and clears the controller ASG table.",
            "default": "127.0.0.1"
        }
    ]
}
